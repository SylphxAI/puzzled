{
	"name": "puzzled-monorepo",
	"version": "0.0.0",
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev --filter=@sylphx/puzzled",
		"build": "turbo run build:with-migrate --filter=@sylphx/puzzled",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"check:proto-buf": "bun scripts/check-proto-buf.ts",
		"verify:live": "bun scripts/verify-live.ts",
		"verify:live:selftest": "bun scripts/verify-live.ts --self-test",
		"local:stack": "bun scripts/local-stack.ts",
		"clean": "turbo clean && rm -rf node_modules",
		"prepare": "git config --unset core.hooksPath >/dev/null 2>&1; lefthook install || true",
		"generate:proto-es": "buf generate || ./.tools/buf generate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@bufbuild/protoc-gen-es": "^2.2.0",
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "26.6.2",
		"lefthook": "2.1.14",
		"turbo": "2.11.2"
	},
	"overrides": {},
	"dependencies": {
		"@bufbuild/protobuf": "^2.2.0",
		"@connectrpc/connect": "^2.0.0",
		"@connectrpc/connect-query": "^2.0.0",
		"@connectrpc/connect-web": "^2.0.0",
		"@tanstack/react-query": "^5.90.0"
	}
}
