# puzzled-server (Rust Connect api service) environment

# Postgres (Neon) — the app's business database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Dest product credentials (not Apps Binding). Commerce gates premium;
# Events authenticates JobsService and delivers push/email.
# COMMERCE_API_ORIGIN="https://api.commerce.sylphx.com"
# COMMERCE_API_KEY="commerce_key_xxx"
# COMMERCE_ENTITLEMENT_POLICY_ID="premium"
# EVENTS_API_ORIGIN="https://api.events.sylphx.com"
# EVENTS_API_KEY="events_key_xxx"
# EVENTS_PUSH_CONNECTOR_ID="connector_push_xxx"
# EVENTS_EMAIL_CONNECTOR_ID="connector_email_xxx"
# EVENTS_EMAIL_FROM="noreply@puzzled.gg"

# JWT verification
# PUZZLED_ENV="production"            # enables audience/issuer enforcement
# PLATFORM_JWT_AUDIENCE="sylphx"      # required when PUZZLED_ENV=production
# PLATFORM_JWT_ISSUER="sylphx"        # required when PUZZLED_ENV=production
# PLATFORM_JWKS_URL="https://api.sylphx.com/.well-known/jwks.json"

# HTTP
# PUZZLED_HTTP_PORT="8080"
