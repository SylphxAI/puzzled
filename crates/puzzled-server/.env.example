# puzzled-server (Rust Connect api service) environment

# Postgres (Neon) — the app's business database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Dest product credentials (not Apps Binding). Events authenticates
# JobsService and delivers push/email.
# EVENTS_API_ORIGIN="https://api.events.sylphx.com"
# EVENTS_API_KEY="events_key_xxx"
# EVENTS_PUSH_CONNECTOR_ID="connector_push_xxx"
# EVENTS_EMAIL_CONNECTOR_ID="connector_email_xxx"
# EVENTS_EMAIL_FROM="noreply@puzzled.gg"

# Sylphx Auth end-user sessions are checked at SYLPHX_AUTH_URL
# (default https://api.sylphx.com), bound by Enable Auth.
# SYLPHX_AUTH_URL="https://api.sylphx.com"

# Account erasure also deletes the player's Sylphx Auth sign-in (Auth's
# privacy-request API), which needs the instance id and secret key — both
# bound by Enable Auth. Without them an account deletion is refused rather
# than leaving a live sign-in behind.
# SYLPHX_AUTH_ORGANIZATION_ID="org_xxx"
# SYLPHX_AUTH_SECRET_KEY="sk_xxx"

# JWT verification
# PUZZLED_ENV="production"            # enables audience/issuer enforcement
# PLATFORM_JWT_AUDIENCE="sylphx"      # required when PUZZLED_ENV=production
# PLATFORM_JWT_ISSUER="sylphx"        # required when PUZZLED_ENV=production
# PLATFORM_JWKS_URL="https://api.sylphx.com/.well-known/jwks.json"

# HTTP
# PUZZLED_HTTP_PORT="8080"

# Puzzled Plus through Sylphx Money. Set = entitlements, checkout and prices
# come from Money. The product's own API key (its *:write covers money:write on
# its own project and env); the org, project and env come from the key's whoami.
# SYLPHX_API_KEY="sk_xxx"
# SYLPHX_API_URL="https://api.sylphx.com"

# PUZZLED_PUBLIC_URL="https://puzzled.gg"  # checkout and portal return URLs
# STRIPE_API_BASE="https://api.stripe.com" # tests point this at a fake
