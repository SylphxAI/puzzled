# puzzled-server (Rust Connect api service) environment

# Postgres (Neon) — the app's business database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Platform app secret — authenticates outbound Platform BaaS calls (billing,
# email, push) and inbound job callbacks (x-app-secret)
SYLPHX_SECRET_KEY="sk_prod_xxx"
# SYLPHX_PLATFORM_URL="https://sylphx.com"

# JWT verification
# PUZZLED_ENV="production"            # enables audience/issuer enforcement
# PLATFORM_JWT_AUDIENCE="sylphx"      # required when PUZZLED_ENV=production
# PLATFORM_JWT_ISSUER="sylphx"        # required when PUZZLED_ENV=production
# PLATFORM_JWKS_URL="https://api.sylphx.com/.well-known/jwks.json"

# HTTP
# PUZZLED_HTTP_PORT="8080"
