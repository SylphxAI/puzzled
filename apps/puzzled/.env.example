# ===================
# Database (Rust api only)
# ===================
# Presentation (Next.js web) must boot without this. The api service consumes
# Platform-injected DATABASE_URL / POSTGRES_URL. Set locally only for atlas,
# content generation, or residual admin pages that still import drizzle.
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ===================
# Dest peels (Identity, Data, Compute, Events, Commerce, AI)
# ===================
# Product credentials issued by each dest product. Not Apps Binding.
# IDENTITY_API_ORIGIN="https://api.identity.sylphx.com"
# IDENTITY_API_KEY="identity_org_key_xxx"
# IDENTITY_ORGANIZATION_ID="org_xxx"
# DATA_API_ORIGIN="https://api.data.sylphx.com"
# DATA_API_KEY="data_key_xxx"
# COMPUTE_API_ORIGIN="https://api.compute.sylphx.com"
# COMPUTE_API_KEY="compute_key_xxx"
# EVENTS_API_ORIGIN="https://api.events.sylphx.com"
# EVENTS_API_KEY="events_key_xxx"
# COMMERCE_API_ORIGIN="https://api.commerce.sylphx.com"
# COMMERCE_API_KEY="commerce_key_xxx"
# AI_API_ORIGIN="https://api.sylphx.ai/v1"
# AI_API_KEY="ai_key_xxx"
# NEXT_PUBLIC_SYLPHX_APP_ID="app_prod_xxx"

# ===================
# Connect API (Rust puzzled-server)
# ===================
# Browser: same-origin by default — the Sylphx edge routes /puzzled.v1.* path
# prefixes to the api service (sylphx.toml). No URL needed in production.
# NEXT_PUBLIC_CONNECT_URL="https://api.example.com"   # explicit public override
# API_INTERNAL_URL="http://api.svc:8080"              # platform-injected private web->api (server side)

# ===================
# App
# ===================
# NEXT_PUBLIC_APP_URL="https://puzzled.gg"   # absolute public origin

# ===================
# Redis (residual admin rate limiting only)
# ===================
# Not required for web boot. Residual admin I/O still reads REDIS_URL at use.
# REDIS_URL="redis://:password@host:6379"
