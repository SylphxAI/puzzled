# ===================
# Database (Neon)
# ===================
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ===================
# Sylphx Platform (auth, billing, AI, email/push, feature flags)
# ===================
# Get these from https://sylphx.com/admin/apps/[your-app]/settings
# Secret key (server-side) — identifies the app for private Platform API calls
SYLPHX_SECRET_KEY="sk_prod_xxx"
# App ID (client-side) — identifies the app for public API calls
NEXT_PUBLIC_SYLPHX_APP_ID="app_prod_xxx"
# Platform URL (optional) — defaults to https://sylphx.com
# NEXT_PUBLIC_SYLPHX_PLATFORM_URL="https://sylphx.com"
# SYLPHX_PLATFORM_URL="https://sylphx.com"  # Server-side only

# ===================
# Connect API (Rust puzzled-server)
# ===================
# Browser: same-origin by default — the Sylphx edge routes /puzzled.v1.* path
# prefixes to the api service (sylphx.toml). No URL needed in production.
# NEXT_PUBLIC_CONNECT_URL="https://api.example.com"   # explicit public override
# API_INTERNAL_URL="http://api.svc:8080"              # platform-injected private web->api (server side)

# ===================
# App
# ===================
# NEXT_PUBLIC_APP_URL="https://puzzled.gg"   # absolute public origin

# ===================
# Redis (admin rate limiting)
# ===================
REDIS_URL="redis://:password@host:6379"
